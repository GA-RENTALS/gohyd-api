DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_URL=postgres://USER:PASSWORD@localhost:5432/gohyderabad
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_NAME=gohyd_otp
WHATSAPP_APP_SECRET=
# Cashfree: App ID and Secret Key from the Cashfree dashboard (Developers → API Keys). Use the sandbox pair with
# CASHFREE_ENV=sandbox until testing is finished. Never commit real keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Public HTTPS address of this API, for Cashfree's payment notifications, e.g. https://hyderabad.goadventure.in
PUBLIC_API_ORIGIN=
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# POSTGRES_ALLOW_OLD=True   # dev only: local PostgreSQL older than 15

# File uploads (photos, documents). Leave AWS_STORAGE_BUCKET_NAME empty to store files on this machine (dev only).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Payment screenshots and proofs are private on S3; staff links expire after this many seconds.
PRIVATE_FILE_URL_SECONDS=600

# The reverse proxy (nginx) in front of the API: its address(es), comma-separated, so rate limits and the audit log
# see the visitor's real IP from X-Forwarded-For. Leave empty only if nothing sits in front of Django.
TRUSTED_PROXY_IPS=

# Per-form rate limits for public endpoints (defaults shown; Django REST framework format).
# EVENT_BOOKING_RATE=20/hour
# COUPON_PREVIEW_RATE=30/hour
# BOOKING_LOOKUP_RATE=20/hour
# PAYMENT_PROOF_RATE=10/hour
# CONTACT_ENQUIRY_RATE=20/hour
# CORPORATE_ENQUIRY_RATE=10/hour
# NEWSLETTER_SIGNUP_RATE=10/hour
